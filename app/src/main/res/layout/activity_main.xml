<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/background"
    android:padding="28dp">

    <!-- Push content to center -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Official EduPredict AI Logo -->
    <ImageView
        android:id="@+id/splashLogo"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_edupredict_logo" />

    <!-- App Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/app_name"
        android:textColor="@color/primary"
        android:textSize="32sp"
        android:textStyle="bold"
        android:letterSpacing="0.02" />

    <!-- Tagline -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="AI-Powered Personalized Learning &amp;\nAcademic Performance Prediction"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:lineSpacingExtra="3dp" />

    <ProgressBar
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginTop="36dp"
        android:indeterminateTint="@color/primary" />

    <!-- Push content to center -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Footer Tag -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Intelligent Education Platform • v1.0"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

</LinearLayout>